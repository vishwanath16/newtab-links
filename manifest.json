{
  "manifest_version": 3,
  "name": "Links in New Tab",
  "version": "1.1.0",
  "description": "Opens links in a new tab on the sites you choose (or all sites). Toggle on/off from the toolbar popup.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Links in New Tab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}